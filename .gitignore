# .gitignore
# ---------------------------------------------------------------------------
# Never commit build output, local env, or test artefacts (see CONTRIBUTING.md
# "Branching and commits"). Intentionally tracked: public/data/sgpc-*.json.

# Dependencies
node_modules/

# Next.js build output
.next/
out/
build/

# TypeScript incremental build info (matches any location)
*.tsbuildinfo

# Vercel local config (machine-specific, not shared)
.vercel/

# Environment files (contains secrets / tokens)
.env*

# Playwright artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Logs and coverage
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/

# OS artefacts
.DS_Store
Thumbs.db
